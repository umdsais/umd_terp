{#
  IMPORTANT: We need to use nested span tags around
  the link text to allow spaceless to remove whitespace
  before and after the link text.
#}
{% apply spaceless %}
  {% set target = link['#url'].getOption('attributes')['target'] ?? '_self' %}
  <a href="{{ link['#url'] }}" class="{{ classes }}" target="{{ target }}">
    {% if title %}
      {{ title }}
    {% else %}
      {{ link['#title'] }}
    {% endif %}
  </a>
{% endapply %}