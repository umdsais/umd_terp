{% set sidebar_attribute = create_attribute() %}

{%
  set sidebar_classes = [
    'row',
	'justify-content-center',
  ]
%}

{% include directory ~ '/templates/_includes/global/header.html.twig' %}

<main id="main-content">
	{% block hero %}
		{% if hero_style == 'background' %}
			{% include directory ~ '/templates/_includes/hero/hero--background.html.twig' %}
		{% elseif hero_style == 'overlay' %}
			{% include directory ~ '/templates/_includes/hero/hero--overlay.html.twig' %}
		{% else %}
			{% include directory ~ '/templates/_includes/hero/hero--minimal.html.twig' %}
		{% endif %}
	{% endblock %}
	{% block main %}
		<div class="container page-content">
			{{ page.help }}
			{{ page.highlighted }}
			<div {{sidebar_attribute.addClass(sidebar_classes)}}>
				{% if page.sidebar|render|striptags|trim is not empty and not hide_sidebar %}
					{% block sidebar %}
						<div class="col-800-3">
							{{ page.sidebar }}
						</div>
					{% endblock %}
				{% endif %}
				<div class="col-800-9">
					{{ page.breadcrumbs }}
					{{ page.content }}
				</div>
			</div>
		</div>
	{% endblock %}
</main>

{% include directory ~ '/templates/_includes/global/footer.html.twig' %}
