{#
/**
 * @file
 * Displays the global header.
 *
 */
#}

{# Begin UMD Brand Site Header #}
<umd-element-navigation-header role="navigation">
	<a href="{{ path('<front>') }}" slot="logo">
	{% if logo_path %}
			<img src="{{ logo_path }}" alt="{{ site_name }}"{% if logo_width and logo_height %} width="{{ logo_width }}" height="{{ logo_height }}"{% endif %} loading="eager" decoding="async">
		{% else %}
			<span role="img" aria-label="{{ site_name }} logo" class="site-header__logo-text">
				<span aria-hidden="true">{{ site_name }}</span>
			</span>
		{% endif %}
	</a>
	{{ drupal_menu('main', 1, 2, TRUE) }}
	
	{% if utility_menu_links is defined and utility_menu_links['#items'] is not empty %}
		<div slot="utility-navigation">
			{% for item in utility_menu_links['#items'] %}
				{% set target = item.url.getOption('attributes')['target'] ?? '_self' %}
				<a href="{{ item.url }}" target="{{ target }}">{{ item.title }}</a>
			{% endfor %}
		</div>
		<div slot="primary-slide-content">
			{% for item in utility_menu_links['#items'] %}
				{% set target = item.url.getOption('attributes')['target'] ?? '_self' %}
				<a href="{{ item.url }}" target="{{ target }}">{{ item.title }}</a>
			{% endfor %}
		</div>
	{% endif %}

</umd-element-navigation-header>
{# End UMD Brand Site Header #}
