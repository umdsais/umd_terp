{
  "compilerOptions": {
    "target": "es2020",
    "sourceMap": true,
    "module": "esnext",
    "lib": ["es2020", "dom", "dom.iterable"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "declaration": false,
    "strict": false
  }
}
